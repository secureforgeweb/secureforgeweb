# Reference / vendor copies (do not commit)
_ref/
**/node_modules
.pnpm-store/

# Local TLS certificates (mkcert) — keep folder, ignore private keys/certs
secureforgeweb_web/certs/*.pem
*.pem

# Build outputs
dist/
build/
*.dist

# Environment variables
.env
# Runtime data (AI config with API keys)
**/backend/data/

# Word lock files
~$*
**/~$*

# OS / editor temp
docs/~$*
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
*.bak

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Docs: só screenshots públicos no GitHub (manuais/rascunhos ficam locais)
secureforgeweb_web/docs/**
!secureforgeweb_web/docs/
!secureforgeweb_web/docs/screenshots/
!secureforgeweb_web/docs/screenshots/**

# README operacional interno (conteúdo consolidado no README.md da raiz)
secureforgeweb_web/readme-web.md

# Demo video generation / merge (local only — never commit)
secureforgeweb_web/scripts/_gen_demo_videos_*.py
secureforgeweb_web/scripts/_merge_video*.py

# One-off local TLS/header probes (not part of the app)
secureforgeweb_web/scripts/probe_tls_debug.ts

# Apresentação local do evento (PDF/fonte) — nunca versionar
apresentacao/

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
